# .env.example  --  Copy to .env and fill in your real keys.
# .env is gitignored and must never be committed.

# Google Gemini API key (required for Route 3 VLM fallback)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Picovoice Porcupine access key (required for voice/wake-word mode)
# Get yours (free tier) at: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=
